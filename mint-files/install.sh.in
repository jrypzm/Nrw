#!/bin/sh
# The yrs. Files icon for Linux Mint: a folder of smoked glass over white pages,
# for the file manager (Nemo) in the panel, the menu and Alt+Tab.
#
#   sh install-yrs-files.sh            put the icon on your file manager
#   sh install-yrs-files.sh --undo     bring back the icon it had before
#
# What it does, all inside your home folder:
#   - copies the icon into ~/.local/share/icons, from 16 to 512 pixels
#   - gives the file manager a personal launcher in ~/.local/share/applications
#     that is identical to the system one except for its icon
# No root, nothing downloaded, nothing outside your home folder is touched.
set -eu

NAME=yrs-files
DATA="${XDG_DATA_HOME:-$HOME/.local/share}"
ICONS="$DATA/icons/hicolor"
APPS="$DATA/applications"
KEEP="$DATA/yrs-files"
MARK="X-yrs-files=true"

say() { printf '%s\n' "$*"; }
die() { say "yrs. files: $*" >&2; exit 1; }

refresh() {
    touch "$ICONS" 2>/dev/null || true
    command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database "$APPS" >/dev/null 2>&1 || true
    command -v gtk-update-icon-cache >/dev/null 2>&1 && [ -f "$ICONS/index.theme" ] && gtk-update-icon-cache -q "$ICONS" >/dev/null 2>&1 || true
}

if [ "${1:-}" = "--undo" ] || [ "${1:-}" = "--uninstall" ]; then
    for f in "$APPS"/nemo.desktop "$APPS"/nemo-*.desktop; do
        [ -f "$f" ] && grep -q "^$MARK" "$f" && rm -f "$f"
    done
    # a launcher you had made yourself before comes back as it was
    if [ -d "$KEEP" ]; then
        for f in "$KEEP"/*.desktop; do [ -f "$f" ] && mv "$f" "$APPS/"; done
    fi
    find "$ICONS" -path "*/apps/$NAME.png" -delete 2>/dev/null || true
    rm -rf "$KEEP"
    refresh
    say "Your file manager's icon is back to how it was."
    exit 0
fi

# find the file manager's launcher
SRC=""
for d in $(printf '%s' "${XDG_DATA_DIRS:-/usr/local/share:/usr/share}" | tr ':' ' '); do
    if [ -f "$d/applications/nemo.desktop" ]; then SRC="$d/applications/nemo.desktop"; break; fi
done
[ -n "$SRC" ] || die "couldn't find the file manager (nemo.desktop). Is this Linux Mint with Cinnamon?"

command -v base64 >/dev/null 2>&1 || die "base64 isn't available."

put() {
    mkdir -p "$ICONS/${1}x${1}/apps"
    base64 -d > "$ICONS/${1}x${1}/apps/$NAME.png"
}

@ICONS@

mkdir -p "$APPS" "$KEEP"
# keep a launcher you made yourself, so --undo can bring it back
if [ -f "$APPS/nemo.desktop" ] && ! grep -q "^$MARK" "$APPS/nemo.desktop"; then
    cp "$APPS/nemo.desktop" "$KEEP/nemo.desktop"
fi
# the system launcher, with only the icon changed (in the main entry and its actions)
sed -e "s/^Icon=.*/Icon=$NAME/" -e "/^\[Desktop Entry\]/a $MARK" "$SRC" > "$APPS/nemo.desktop.tmp"
mv "$APPS/nemo.desktop.tmp" "$APPS/nemo.desktop"
refresh

say "Your file manager now has the yrs. Files icon."
say "If you still see the old one, press Ctrl+Alt+Esc to refresh Cinnamon (or log out and in)."
say "To undo: curl -fsSL https://github.com/jrypzm/yrs/releases/download/mint-files/install-yrs-files.sh | sh -s -- --undo"
