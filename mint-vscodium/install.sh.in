#!/bin/sh
# A new icon for VSCodium on Linux Mint: VSCodium's coral in crisp white
# on a bold blue tile with a thin rim of light.
#
#   sh install-yrs-vscodium.sh            give VSCodium the new icon
#   sh install-yrs-vscodium.sh --undo     bring back the icon it had before
#
# What it does, all inside your home folder:
#   - puts the icon in ~/.local/share/icons as "yrs-vscodium", from 16 to 512 pixels
#     (a name of its own, so no icon theme can override it)
#   - gives VSCodium's launcher (apt, Flatpak, Snap or built from source) a personal copy in
#     ~/.local/share/applications, the same as the original except for the icon
#   - keeps a copy of anything it replaces, so --undo puts it all back
# No root, nothing downloaded, VSCodium itself is not touched.
set -eu

DATA="${XDG_DATA_HOME:-$HOME/.local/share}"
ICONS="$DATA/icons/hicolor"
APPS="$DATA/applications"
KEEP="$DATA/yrs-vscodium"
SIZES="16 22 24 32 48 64 96 128 256 512"
NAME="yrs-vscodium"
MARK="X-yrs-vscodium=true"

say() { printf '%s\n' "$*"; }

refresh() {
    touch "$ICONS" 2>/dev/null || true
    command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database "$APPS" >/dev/null 2>&1 || true
    command -v gtk-update-icon-cache >/dev/null 2>&1 && [ -f "$ICONS/index.theme" ] && gtk-update-icon-cache -q "$ICONS" >/dev/null 2>&1 || true
}

if [ "${1:-}" = "--undo" ] || [ "${1:-}" = "--uninstall" ]; then
    for n in $SIZES; do rm -f "$ICONS/${n}x${n}/apps/$NAME.png"; done
    for f in "$APPS"/*.desktop; do [ -f "$f" ] && grep -q "^$MARK" "$f" && rm -f "$f"; done
    if [ -f "$KEEP/themefiles" ]; then
        while IFS= read -r f; do rm -f "$f"; done < "$KEEP/themefiles"
    fi
    if [ -f "$KEEP/themeindex" ]; then
        while IFS= read -r f; do rm -f "$f"; d=$(dirname "$f"); find "$d" -type d -empty -delete 2>/dev/null || true; done < "$KEEP/themeindex"
    fi
    if [ -d "$KEEP/apps" ]; then
        for f in "$KEEP/apps"/*.desktop; do [ -f "$f" ] && cp "$f" "$APPS/"; done
    fi
    rm -rf "$KEEP"
    refresh
    say "VSCodium's icon is back to how it was."
    exit 0
fi

command -v base64 >/dev/null 2>&1 || { say "base64 isn't available." >&2; exit 1; }
mkdir -p "$KEEP/apps" "$APPS"

put() {
    mkdir -p "$ICONS/${1}x${1}/apps"
    base64 -d > "$ICONS/${1}x${1}/apps/$NAME.png"
}

@ICONS@

# every VSCodium launcher on this computer: apt or source, Flatpak (system and yours), Snap
found=""
for d in $(printf '%s' "${XDG_DATA_DIRS:-/usr/local/share:/usr/share}" | tr ':' ' ') \
         /usr/local/share /usr/share /var/lib/flatpak/exports/share "$DATA/flatpak/exports/share" \
         /var/lib/snapd/desktop "$HOME/.local/share"; do
    for src in "$d"/applications/codium.desktop "$d"/applications/com.vscodium.codium.desktop "$d"/applications/codium_codium.desktop "$d"/applications/vscodium.desktop; do
        [ -f "$src" ] || continue
        base=$(basename "$src")
        dest="$APPS/$base"
        [ "$src" = "$dest" ] && continue
        case " $found " in *" $base "*) continue ;; esac   # the first one found wins, as in the menu
        found="$found $base"
        # a launcher you made yourself under that name is kept for --undo
        if [ -f "$dest" ] && ! grep -q "^$MARK" "$dest"; then cp "$dest" "$KEEP/apps/$base"; fi
        sed -e "s/^Icon=.*/Icon=$NAME/" -e "/^\[Desktop Entry\]/a $MARK" "$src" > "$dest.tmp"
        mv "$dest.tmp" "$dest"
    done
done

# other launchers of yours that start VSCodium with another icon
for f in "$APPS"/*.desktop; do
    [ -f "$f" ] || continue
    grep -q "^$MARK" "$f" && continue
    # any launcher that starts VSCodium: codium, the Flatpak, an AppImage or a folder named VSCodium
    grep -Eqi '^Exec=.*codium|^Name=.*vscodium' "$f" || continue
    icon=$(sed -n 's/^Icon=//p' "$f" | head -n 1)
    [ "$icon" = "$NAME" ] && continue
    base=$(basename "$f")
    [ -f "$KEEP/apps/$base" ] || cp "$f" "$KEEP/apps/$base"
    sed "s/^Icon=.*/Icon=$NAME/" "$f" > "$f.tmp" && mv "$f.tmp" "$f"
    found="$found $base"
done
# Mint's icon theme has its own VSCodium pictures under VSCodium's own names, and anything that asks
# for those names (the menu, the panel, the window list, a launcher not found above) gets them.
# So the new picture goes under those names too, in your own copy of the theme's folder, which is
# looked at before the system's. The system theme is not touched.
OLDNAMES="vscodium com.vscodium.codium codium"
ICON_THEME=$(gsettings get org.cinnamon.desktop.interface icon-theme 2>/dev/null | tr -d "'" || true)
t=$ICON_THEME; n=0
: > "$KEEP/themefiles.new"; [ -f "$KEEP/themeindex" ] || : > "$KEEP/themeindex"
while [ -n "$t" ] && [ "$t" != hicolor ] && [ $n -lt 6 ]; do
    n=$((n + 1))
    src=""
    for b in /usr/share/icons /usr/local/share/icons; do [ -f "$b/$t/index.theme" ] && { src="$b/$t/index.theme"; break; }; done
    [ -n "$src" ] || break
    dest="$DATA/icons/$t"
    if [ ! -f "$dest/index.theme" ]; then
        mkdir -p "$dest"; cp "$src" "$dest/index.theme"; printf '%s\n' "$dest/index.theme" >> "$KEEP/themeindex"
    fi
    # every folder of application icons the theme lists, with its size
    awk '
        /^\[/ { sec=substr($0, 2, length($0)-2); next }
        /^Size=/ { size[sec]=substr($0, 6) }
        /^Context=/ { ctx[sec]=substr($0, 9) }
        /^Type=/ { type[sec]=substr($0, 6) }
        END { for (s in size) if (ctx[s]=="Applications" || s ~ /apps/) print s, size[s], type[s] }
    ' "$src" | while read -r dir size type; do
        [ "$dir" = "Icon" ] && continue
        pick=512
        for p in $SIZES; do if [ "$p" -ge "$size" ]; then pick=$p; break; fi; done
        [ "$type" = Scalable ] && pick=512
        mkdir -p "$dest/$dir"
        for nm in $OLDNAMES; do
            cp "$ICONS/${pick}x${pick}/apps/$NAME.png" "$dest/$dir/$nm.png"
            printf '%s\n' "$dest/$dir/$nm.png" >> "$KEEP/themefiles.new"
        done
    done
    t=$(sed -n 's/^Inherits=//p' "$src" | head -n 1 | cut -d, -f1)
done
cat "$KEEP/themefiles.new" >> "$KEEP/themefiles" 2>/dev/null || true
sort -u "$KEEP/themefiles" -o "$KEEP/themefiles"; rm -f "$KEEP/themefiles.new"
for d in "$DATA/icons/$ICON_THEME"; do touch "$d" 2>/dev/null || true; done
refresh

say "VSCodium now has the new icon."
[ -n "$found" ] || say "I didn't find VSCodium on this computer yet; run this again after installing it."
say "If you still see the old one, press Ctrl+Alt+Esc to refresh Cinnamon (or log out and in)."
say "To undo: curl -fsSL https://github.com/jrypzm/yrs/releases/download/mint-vscodium/install-yrs-vscodium.sh | sh -s -- --undo"
