#!/bin/sh
# Violet Quill: a new icon for Zim Desktop Wiki on Linux Mint. A quill in sprayed black ink
# with a white nib, on a grainy violet glow.
#
#   sh install-yrs-zim.sh            give Zim the Violet Quill icon
#   sh install-yrs-zim.sh --undo     bring back the icon it had before
#
# What it does, all inside your home folder:
#   - puts the icon in ~/.local/share/icons as "yrs-zim", from 16 to 512 pixels; a name
#     of its own, because Mint's icon theme has its own Zim icon that would win otherwise
#   - gives Zim's launchers (apt and Flatpak) a personal copy in ~/.local/share/applications,
#     the same as the system's except for the icon; yours is used before theirs
#   - keeps a copy of anything it replaces, so --undo puts it all back
# No root, nothing downloaded, Zim itself is not touched.
set -eu

DATA="${XDG_DATA_HOME:-$HOME/.local/share}"
ICONS="$DATA/icons/hicolor"
APPS="$DATA/applications"
KEEP="$DATA/yrs-zim"
SIZES="16 22 24 32 48 64 96 128 256 512"
NAME="yrs-zim"
MARK="X-yrs-zim=true"

say() { printf '%s\n' "$*"; }

refresh() {
    touch "$ICONS" 2>/dev/null || true
    command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database "$APPS" >/dev/null 2>&1 || true
    command -v gtk-update-icon-cache >/dev/null 2>&1 && [ -f "$ICONS/index.theme" ] && gtk-update-icon-cache -q "$ICONS" >/dev/null 2>&1 || true
}

if [ "${1:-}" = "--undo" ] || [ "${1:-}" = "--uninstall" ]; then
    for n in $SIZES; do rm -f "$ICONS/${n}x${n}/apps/$NAME.png"; done
    if [ -d "$KEEP/icons" ]; then
        (cd "$KEEP/icons" && find . -type f) | while IFS= read -r f; do
            mkdir -p "$(dirname "$ICONS/$f")"; cp "$KEEP/icons/$f" "$ICONS/$f"
        done
    fi
    for f in "$APPS"/*.desktop; do [ -f "$f" ] && grep -q "^$MARK" "$f" && rm -f "$f"; done
    if [ -d "$KEEP/apps" ]; then
        for f in "$KEEP/apps"/*.desktop; do [ -f "$f" ] && cp "$f" "$APPS/"; done
    fi
    rm -rf "$KEEP"
    refresh
    say "Zim's icon is back to how it was."
    exit 0
fi

command -v base64 >/dev/null 2>&1 || { say "base64 isn't available." >&2; exit 1; }
mkdir -p "$KEEP/icons" "$KEEP/apps"

put() {
    mkdir -p "$ICONS/${1}x${1}/apps"
    base64 -d > "$ICONS/${1}x${1}/apps/$NAME.png"
}

@ICONS@

# an earlier version of this installer (it left "$KEEP/installed") used Zim's own icon names,
# which Mint's theme beat; remove the ones it put there and put back anything it had kept
if [ -f "$KEEP/installed" ]; then
for n in $SIZES; do
    for old in org.zim_wiki.Zim zim; do
        f="$ICONS/${n}x${n}/apps/$old.png"
        rm -f "$f"
        [ -f "$KEEP/icons/${n}x${n}/apps/$old.png" ] && cp "$KEEP/icons/${n}x${n}/apps/$old.png" "$f"
    done
done
rm -rf "$KEEP/icons" "$KEEP/installed"
fi

# every Zim launcher on this computer: apt, Flatpak (system and yours), older versions
found=""
for d in $(printf '%s' "${XDG_DATA_DIRS:-/usr/local/share:/usr/share}" | tr ':' ' ') \
         /var/lib/flatpak/exports/share "$DATA/flatpak/exports/share" /usr/share /usr/local/share; do
    for src in "$d"/applications/org.zim_wiki.Zim.desktop "$d"/applications/zim.desktop; do
        [ -f "$src" ] || continue
        base=$(basename "$src")
        dest="$APPS/$base"
        [ -n "$(printf '%s' "$found" | grep -F " $base")" ] && continue   # the first one found wins, as in the menu
        found="$found $base"
        mkdir -p "$APPS"
        # a launcher you made yourself under that name is kept for --undo
        if [ -f "$dest" ] && ! grep -q "^$MARK" "$dest"; then cp "$dest" "$KEEP/apps/$base"; fi
        sed -e "s/^Icon=.*/Icon=$NAME/" -e "/^\[Desktop Entry\]/a $MARK" "$src" > "$dest.tmp"
        mv "$dest.tmp" "$dest"
    done
done

# other launchers of yours that start Zim with another icon
for f in "$APPS"/*.desktop; do
    [ -f "$f" ] || continue
    grep -q "^$MARK" "$f" && continue
    grep -Eqi '^Exec=(.*/)?zim( |$)|^Exec=.*org\.zim_wiki\.Zim' "$f" || continue
    icon=$(sed -n 's/^Icon=//p' "$f" | head -n 1)
    [ "$icon" = "$NAME" ] && continue
    base=$(basename "$f")
    [ -f "$KEEP/apps/$base" ] || cp "$f" "$KEEP/apps/$base"
    sed "s/^Icon=.*/Icon=$NAME/" "$f" > "$f.tmp" && mv "$f.tmp" "$f"
    found="$found $base"
done
refresh

say "Zim now has the Violet Quill icon."
[ -n "$found" ] || say "I didn't find Zim on this computer yet; the icon will show as soon as it's installed (sudo apt install zim)."
say "If you still see the old one, press Ctrl+Alt+Esc to refresh Cinnamon (or log out and in)."
say "To undo: curl -fsSL https://github.com/jrypzm/yrs/releases/download/mint-zim/install-yrs-zim.sh | sh -s -- --undo"
